# Never commit real values. Mainnet stays off unless you explicitly enable it.
MODE=sim                  # sim | testnet | mainnet
MAINNET_ENABLED=false
MAINNET_SPEND_CAP_USDC=20
BASE_RPC_URL=
BASE_SEPOLIA_RPC_URL=

# SEC asks for a name and contact email on every request
SEC_USER_AGENT=

# Research model: anthropic | gemini
LLM_PROVIDER=gemini
RESEARCH_MODEL=gemini-3.8-flash
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Paid-tier price per million tokens for RESEARCH_MODEL, read from the provider's pricing page.
# Use paid-tier rates even on a free tier so the ledger books a realistic metered cost.
PRICE_INPUT_PER_MTOK_USD=
PRICE_OUTPUT_PER_MTOK_USD=

# Hard cap per brief run; calls that could exceed it are refused
RESEARCH_MAX_USD=1.50
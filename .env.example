# Never commit real values. Mainnet stays off unless you explicitly enable it.
MODE=sim                  # sim | testnet | mainnet
MAINNET_ENABLED=false
MAINNET_SPEND_CAP_USDC=20
# Real swaps only. Needs MAINNET_ENABLED=true, a spend cap and a throwaway wallet holding real USDC.
# Leave empty and fills stay simulated, which is the normal state.
EXECUTION_PRIVATE_KEY=
BASE_RPC_URL=
BASE_SEPOLIA_RPC_URL=

# SEC asks for a name and contact email on every request
SEC_USER_AGENT=

# Research model: anthropic | gemini
LLM_PROVIDER=gemini
RESEARCH_MODEL=gemini-3.8-flash
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Paid-tier price per million tokens for RESEARCH_MODEL, read from the provider's pricing page.
# Use paid-tier rates even on a free tier so the ledger books a realistic metered cost.
PRICE_INPUT_PER_MTOK_USD=
PRICE_OUTPUT_PER_MTOK_USD=

# Hard cap per brief run; calls that could exceed it are refused
RESEARCH_MAX_USD=1.50

# x402 paid endpoint (apps/api). Base Sepolia is the only EVM network the free
# x402.org facilitator serves, so leave X402_NETWORK alone unless you have a
# facilitator that settles elsewhere. Serving on Base mainnet also needs MAINNET_ENABLED=true.
X402_PAY_TO=                                        # address that receives USDC, required
X402_NETWORK=eip155:84532                           # eip155:84532 Base Sepolia | eip155:8453 Base mainnet
X402_FACILITATOR_URL=https://x402.org/facilitator   # free, no auth, testnet only
BRIEF_PRICE_USD=$0.01                               # price of the newest cached brief (GET /brief)
RESEARCH_PRICE_USD=$2.00                            # price of an on-demand brief (POST /research)
RESEARCH_TOTAL_MAX_USD=10.00                        # ceiling on research spend for the life of the process
BRIEF_MAX_AGE_SECONDS=86400                         # reuse a brief for the same themes within this window
PORT=4021
BRIEFS_DIR=docs/briefs                              # the owner's catalogue, served by GET /brief
CUSTOM_BRIEFS_DIR=                                  # buyer-commissioned briefs; defaults to data/briefs-custom
PUBLIC_LEDGER=false                                 # true publishes GET /ledger; it is the whole sales history
LEDGER_PATH=                                        # defaults to data/ledger-<mode>.jsonl at the repo root
# Only set this to override the USDC address for the network above.
X402_EXPECTED_ASSET=

# Owner routes (propose/approve/execute). No default and no open mode: unset means the server refuses
# to start. This is a shared secret, NOT the owner's signature on a trade; EIP-712 replaces it.
OWNER_TOKEN=
# The address whose EIP-712 signature authorizes an approval. Required: approvals have no unsigned path.
OWNER_ADDRESS=
APPROVAL_CHAIN_ID=                                  # defaults to the chain being sold on (84532 / 8453)
# Owner signing key, for `npm run approve -w @surplus/api` only. A throwaway wallet.
# Never commit it and never paste it into chat.
OWNER_PRIVATE_KEY=
INVEST_MODE=sim                                     # sim | testnet | mainnet; mainnet also needs MAINNET_ENABLED=true
INVEST_LEDGER_PATH=                                 # defaults to data/ledger-invest-<mode>.jsonl
MANDATE_PATH=                                       # defaults to data/mandate.jsonl; stored terms win over code
OPENING_FLOAT_USDC=1.00                             # owner working capital; model costs precede revenue

# Buyer side, for `npm run buy -w @surplus/api` only. A throwaway testnet key.
# Never commit it and never paste it into chat.
X402_BUYER_PRIVATE_KEY=
X402_API_URL=http://localhost:4021